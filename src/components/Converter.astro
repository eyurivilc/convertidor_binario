---
import CopyButton from './CopyButton.astro';
import Icon from './Icon.astro';
---
<main class="mx-auto max-w-6xl px-5 pb-16 sm:px-8">
  <section class="py-10 sm:py-16">
    <p class="mono mb-4 text-sm font-bold tracking-widest text-[var(--accent)]">HERRAMIENTA INTERACTIVA · 100% LOCAL</p>
    <h1 class="max-w-3xl text-4xl font-black tracking-tight sm:text-6xl">Entiende cada bit.<br /><span class="text-[var(--accent)]">No solo el resultado.</span></h1>
    <p class="mt-6 max-w-2xl text-lg leading-8 text-[var(--muted)]">Convierte texto y binario mientras ves cómo cada posición aporta su valor. Sin cuenta, sin servidores, sin magia.</p>
  </section>

  <section class="surface rounded-3xl p-5 sm:p-8" aria-labelledby="converter-title">
    <div class="mb-7 flex flex-wrap items-start justify-between gap-4">
      <div><h2 id="converter-title" class="text-2xl font-bold">Conversor</h2><p class="mt-1 text-sm text-[var(--muted)]">Elige la dirección y la codificación.</p></div>
      <span id="status" class="rounded-full bg-[var(--surface-2)] px-3 py-1 text-xs font-semibold text-[var(--muted)]" aria-live="polite">Listo</span>
    </div>
    <div class="grid gap-5 md:grid-cols-2">
      <label class="block text-sm font-bold"><span class="flex items-center gap-2"><Icon name="conversion" />Dirección</span>
        <select id="direction" class="control mt-2" aria-label="Dirección de conversión"><option value="text-to-binary">Texto → binario</option><option value="binary-to-text">Binario → texto</option></select>
      </label>
      <label class="block text-sm font-bold"><span class="flex items-center gap-2"><Icon name="encoding" />Codificación</span>
        <select id="encoding" class="control mt-2" aria-label="Codificación"><option value="ascii">ASCII · 8 bits</option><option value="utf8">UTF-8 · bytes variables</option><option value="unicode">Unicode · puntos de código</option></select>
      </label>
    </div>
    <div class="mt-6 grid gap-5 lg:grid-cols-2">
      <div><div class="mb-2 flex items-center justify-between"><label id="input-label" for="input" class="text-sm font-bold">Texto de entrada</label><span id="counter" class="text-xs text-[var(--muted)]">0 / 100</span></div><textarea id="input" class="control mono min-h-36 resize-y" maxlength="100" placeholder="Escribí algo, por ejemplo: Hola" spellcheck="false"></textarea></div>
      <div><div class="mb-2 flex items-center justify-between gap-3"><label id="output-label" for="output" class="text-sm font-bold">Resultado</label><CopyButton><Icon slot="icon" name="copy" className="size-4 shrink-0" /></CopyButton></div><textarea id="output" class="control mono min-h-36 resize-y" readonly aria-live="polite"></textarea></div>
    </div>
    <p id="message" class="message mt-3 min-h-6 text-sm text-[var(--muted)]" role="status" aria-live="polite" aria-atomic="true"></p>
    <div class="mt-5 flex flex-wrap gap-3"><button id="example" class="button button-primary inline-flex items-center gap-2" type="button"><Icon name="binary" />Cargar ejemplo</button><button id="clear" class="button button-quiet inline-flex items-center gap-2" type="button"><Icon name="clear" />Limpiar</button></div>
  </section>

  <section class="mt-10" aria-labelledby="trace-title"><div class="mb-5"><p class="mono text-sm font-bold tracking-widest text-[var(--accent)]">TRAZA DE CÁLCULO</p><h2 id="trace-title" class="mt-2 text-3xl font-black">Así se construye el valor</h2><p class="mt-2 text-[var(--muted)]">Cada tarjeta explica un carácter, byte o punto de código.</p></div><div id="trace" class="grid gap-4 md:grid-cols-2" aria-live="polite"><p class="surface rounded-2xl p-6 text-[var(--muted)]">Ingrese el contenido para ver el desglose.</p></div></section>
</main>
<script>
  import '../scripts/converter-ui';
</script>
