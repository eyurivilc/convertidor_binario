---
type IconName = 'conversion' | 'copy' | 'clear' | 'theme' | 'binary' | 'encoding';

interface Props {
  name: IconName;
  className?: string;
}

const { name, className = 'size-4' } = Astro.props;
---

<svg class={className} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  {name === 'conversion' && <><path d="M4 7h13" /><path d="m14 3 4 4-4 4" /><path d="M20 17H7" /><path d="m10 13-4 4 4 4" /></>}
  {name === 'copy' && <><rect x="9" y="9" width="11" height="11" rx="2" /><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1" /></>}
  {name === 'clear' && <><path d="M5 7h14" /><path d="M10 11v5M14 11v5" /><path d="M8 7l1 13h6l1-13" /><path d="M10 7V4h4v3" /></>}
  {name === 'theme' && <><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41" /></>}
  {name === 'binary' && <><path d="M5 5v14M5 5h3a3 3 0 0 1 0 6H5M5 11h3a3 3 0 0 1 0 6H5" /><path d="M15 6a3 3 0 1 1 6 0v12a3 3 0 1 1-6 0V6Z" /></>}
  {name === 'encoding' && <><path d="M4 5h16M4 19h16M7 5c0 9 2 14 5 14s5-5 5-14M7 19c0-9 2-14 5-14s5 5 5 14" /></>}
</svg>
