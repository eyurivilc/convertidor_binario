---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Converter from '../components/Converter.astro';
const faviconUrl = `${import.meta.env.BASE_URL}/favicon.svg`;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="Binarix convierte texto, binario, ASCII, UTF-8 y Unicode de manera clara y local." />
    <link rel="icon" href={faviconUrl} type="image/svg+xml" />
    <title>Binarix · Conversor de texto y binario</title>
  </head>
  <body><Header /><Converter /></body>
</html>
